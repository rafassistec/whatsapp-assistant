# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (transcrição de áudio)
OPENAI_API_KEY=sk-...

# Evolution API
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=sua-api-key
EVOLUTION_INSTANCE_NAME=ethan

# Webhook
WEBHOOK_PATH=/webhook
PORT=3001
HOST=0.0.0.0

# WhatsApp do dono (recebe notificações de takeover e aceita comandos)
# Formato: só dígitos com DDI+DDD, ex: 5511999999999
OWNER_PHONE=5511999999999

# Memória (quantas mensagens de contexto por conversa)
MEMORY_WINDOW=40

# Modelos Claude (opcional — usa os padrões se omitir)
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_VISION_MODEL=claude-sonnet-4-6

# SQLite
# DB_PATH=./data/memory.db
